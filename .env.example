# Backend and tooling environment. These are read from the process environment (export them, or set
# them in your process manager or docker-compose.yml); nothing loads this file automatically.

# --- Backend (FastAPI) ---------------------------------------------------------------------------
# Allowed browser origins for cross origin calls, comma separated. Only needed when the frontend is
# served from a different origin than the API. Default: the local Vite dev and preview origins.
NETSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Largest accepted request body in bytes (413 PAYLOAD_TOO_LARGE above it). Default 1048576.
NETSHIELD_MAX_REQUEST_BYTES=1048576
# Server side time budget for one simulation or sweep, in ms (504 TIMEOUT above it). Default 10000.
NETSHIELD_SIMULATION_BUDGET_MS=10000
# Production only: folder with the built frontend to serve from the same origin (start:prod sets it
# to frontend/dist). Unset: the backend serves only the API.
NETSHIELD_STATIC_DIR=

# --- Launch scripts (scripts/dev-backend.mjs, scripts/start-prod.mjs) -------------------------------
# Port of the backend. Default 8000. The Vite dev and preview proxy follow it.
NETSHIELD_API_PORT=8000
# start:prod only: interface to listen on (0.0.0.0 to accept outside connections) and worker count.
NETSHIELD_API_HOST=127.0.0.1
NETSHIELD_WORKERS=1
# dev-backend only: 0 disables auto reload (the end to end tests use 0).
NETSHIELD_API_RELOAD=1
# Vite only: full proxy target, overriding http://127.0.0.1:${NETSHIELD_API_PORT}.
NETSHIELD_API_PROXY_TARGET=

# --- Tests ---------------------------------------------------------------------------------------
# Running backend for the frontend integration tests and fixture capture (npm run test:integration).
NETSHIELD_API_URL=http://127.0.0.1:8765
