# Copy to frontend/.env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the FastAPI backend, without a trailing slash.
# Leave empty (the default) when the API is served from the same origin: in development the Vite
# dev server proxies /api to the backend, and in production `npm run start:prod` serves the app and
# the API from one uvicorn process. Set it only when the API is on a different origin, for example
#   VITE_API_BASE_URL=https://api.netshield.example
# and then allow this app's origin on the backend with NETSHIELD_CORS_ORIGINS.
VITE_API_BASE_URL=

# Demo mode at startup. Only the exact value "true" enables it. Then every analysis, simulation and
# sweep is computed in the browser by the demo adapter, a banner is shown on every app page, and every
# result is labelled "Demo result". Any other value (default): every call goes to the FastAPI backend,
# and a failed call shows an error with Retry. The app never switches to demo mode on its own; users can
# choose "Use demo mode" from the offline banner.
VITE_USE_DEMO_ADAPTER=false
