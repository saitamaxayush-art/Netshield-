# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the FastAPI backend, without a trailing slash.
# Leave empty in development: the app calls /api on its own origin and the Vite
# dev server proxies /api to http://127.0.0.1:8000 (no CORS needed).
# Set it when the API is hosted on a different origin, for example:
# VITE_API_BASE_URL=https://api.netshield.example
VITE_API_BASE_URL=

# Demo mode. Only the exact value "true" enables it. Then simulation and sweep run in the
# browser, the studio shows a "Demo mode is on" banner, and every result is labelled
# "Demo result". Graph analysis is not available in demo mode. Any other value (default):
# every call goes to the FastAPI backend, and a failed call shows an error with Retry. The
# app never switches to demo results on its own.
VITE_USE_DEMO_ADAPTER=false
